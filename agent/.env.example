# llm/live 모드에서 사용한다. 실제 키는 .env에 저장하고 커밋하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=
REGULATION_MCP_URL=http://localhost:8001/mcp
BUSINESS_MCP_URL=http://localhost:8003/mcp
# 선택: 샘플 데이터 폴더를 바꿀 때만 설정
# RIPPLE_DATA_DIR=/absolute/path/to/data
# HTTP 어댑터 (uvicorn app.server:create_app --factory). AGENT_MODE 는 llm | live
AGENT_MODE=llm
INTERNAL_TOKEN=rr-internal-dev-token
# AGENT_CHECKPOINT_DB=postgresql://ruleripple:ruleripple@localhost:5432/ruleripple
